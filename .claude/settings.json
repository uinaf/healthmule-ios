{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(./scripts/check-app-dependencies.sh)",
      "Bash(./scripts/check-swift-syntax.sh)",
      "Bash(./scripts/generate-project.sh)",
      "Bash(./scripts/install-xcodegen.sh:*)",
      "Bash(./scripts/parse-booted-iphone-ids.sh:*)",
      "Bash(./scripts/select-simulator-id.sh:*)",
      "Bash(./scripts/simulator-destination.sh)",
      "Bash(./scripts/swift.sh:*)",
      "Bash(./scripts/test-infrastructure.sh)",
      "Bash(./scripts/with-xcode-lock.sh:*)",
      "Bash(./scripts/xcodebuild.sh:*)",
      "Bash(./scripts/xcrun.sh simctl list:*)",
      "Bash(./scripts/xcrun.sh simctl boot:*)",
      "Bash(./scripts/xcrun.sh simctl shutdown:*)",
      "Bash(./scripts/xcrun.sh simctl install:*)",
      "Bash(./scripts/xcrun.sh simctl launch:*)",
      "Bash(./scripts/xcrun.sh simctl terminate:*)",
      "Bash(./scripts/xcrun.sh simctl spawn:*)",
      "Bash(./scripts/xcrun.sh xcresulttool:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git stash list)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)"
    ],
    "deny": [
      "Read(./Config/Secrets.xcconfig)",
      "Read(./Config/Signing.xcconfig)",
      "Bash(xcrun simctl erase:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
